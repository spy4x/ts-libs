{
  // Every package an extraction PR will add is listed here up front. Deno skips
  // a workspace member whose directory does not exist yet (one `Skipping.`
  // warning on stderr, exit 0), so a package becomes a real member the moment
  // its own `<dir>/deno.json` lands. That is what keeps this file untouched by
  // every package PR — no shared-file conflicts between parallel agents.
  //
  // The list mirrors the `Scope` block of README.md. `infra/` is deliberately
  // not a member: `infra/scripts/type-check.ts` is repo tooling, not a package.
  "workspace": [
    "./ai",
    "./email",
    "./integrations",
    "./net",
    "./platform",
    "./realtime",
    "./server",
    "./time",
    "./validation"
  ],
  "tasks": {
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": ["fmt:check", "lint", "ts:check", "test"]
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "ts:check": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
    // Every test in the workspace reads its own sources, and a few read env
    // vars. Both grants are as narrow as the tests allow; they are repo-wide
    // only because `deno test` discovers every member's suite in one process.
    // Nothing here needs `net`, `run` or `write`.
    "test": "deno test --no-prompt --allow-read --allow-env",
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": ["lint:fix", "fmt"]
    }
  },
  "imports": {
    // Validation — arktype only, never zod. `platform/` types (#10, #23),
    // `ai/chatJson` schemas (#11), `server/auth` bodies (#6).
    "arktype": "npm:arktype@2.2.3",

    // Stdlib. Nothing else may be added without naming the issue that needs it.
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/expect": "jsr:@std/expect@1.0.20",
    // `@std/testing` has no "." export — only subpaths — so only the one
    // subpath in use is mapped; a bare `@std/testing` entry has no importer.
    "@std/testing/bdd": "jsr:@std/testing@1.0.20/bdd",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/crypto": "jsr:@std/crypto@1.1.0",
    // `platform/tokens.ts`'s ULID generator (#70): replaces a hand-written encoder that existed
    // only because this pin was missing.
    "@std/ulid": "jsr:@std/ulid@1.0.0",

    // HTTP framework. `server/http` (#9) and `platform/rate-limit` (#4)
    // middleware.
    "hono": "jsr:@hono/hono@4.13.8",

    // Postgres driver for `server/db` (#15).
    "postgres": "npm:postgres@3.4.7"
  },
  "compilerOptions": {
    // An explicit "lib" replaces Deno's default lib set, so "deno.ns" has to be
    // listed back or `Deno.*` disappears from every repository script.
    "lib": ["ES2020", "DOM", "DOM.Iterable", "deno.ns"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [
    ".volumes",
    "**/coverage/*",
    "**/dist/*",
    "node_modules",
    "*.lock"
  ]
}
