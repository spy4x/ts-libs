{
  // Every package an extraction PR will add is listed here up front. Deno skips
  // a workspace member whose directory does not exist yet (one `Skipping.`
  // warning on stderr, exit 0), so a package becomes a real member the moment
  // its own `<dir>/deno.json` lands. That is what keeps this file untouched by
  // every package PR — no shared-file conflicts between parallel agents.
  //
  // The list mirrors the `Scope` block of README.md. `infra/` is deliberately
  // not a member: `infra/scripts/type-check.ts` is repo tooling, not a package.
  "workspace": [
    "./ai",
    "./email",
    "./integrations",
    "./net",
    "./platform",
    "./realtime",
    "./server",
    "./time",
    "./validation"
  ],
  "tasks": {
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": ["fmt:check", "lint", "ts:check", "test"]
    },
    // Both tiers, unit first — the order issue #74 asks for. `check` itself stays
    // free of Docker so a package PR can be verified on a machine with no
    // containers; this is the task that adds the integration tier on top.
    "check:all": {
      "command": "deno task check && deno task test:integration",
      "description": "Run all checks, then the integration tier"
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "ts:check": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
    // CI emulation: the named tasks (default `check`) with `CI=true` and an empty `DENO_DIR`
    // under `.volumes/denodir/`, removed afterwards. A task rather than a shell block so that
    // nobody runs `rm` on a shell variable — see `infra/scripts/cold-check.ts`.
    "check:cold": "deno run --allow-read=.volumes,deno.lock --allow-write=.volumes --allow-run=deno infra/scripts/cold-check.ts",
    // Every test in the workspace reads its own sources, and a few read env
    // vars. Both grants are as narrow as the tests allow; they are repo-wide
    // only because `deno test` discovers every member's suite in one process.
    // Nothing here needs `net`, `run` or `write`.
    //
    // `--ignore` is what keeps the two tiers apart: Deno's discovery matches
    // `*.test.ts`, and `x.integration.test.ts` ends in `.test.ts`, so without it
    // the unit run would pick up the integration suite and fail with no container.
    // `.volumes` is named here as well because `--ignore` replaces the root `exclude` for this
    // run instead of adding to it; without it a `*.test.ts` under `.volumes` would be run.
    "test": "deno test --no-prompt --allow-read --allow-env --ignore=**/*.integration.test.ts,.volumes",
    // The integration tier. The glob is the only thing that selects it, so a file
    // joins the tier by its name alone.
    //
    // `--allow-net` carries no address list, and that is a concession rather than a
    // preference. Two CI runs proved an enumerated list cannot work: nodemailer
    // resolves the relay name itself and then dials the address it got back, so
    // `mailpit:1025` fails the name lookup (`getaddrinfo EPERM`) and adding the bare
    // name only moves the failure to the resolved address (`Requires net access to
    // "10.200.2.4:1025"`), which Woodpecker assigns per run and no list can predict.
    // `--allow-read` and `--allow-env` stay as narrow as the unit tier's, and no
    // integration test may reach anything but the three services regardless.
    // `--allow-write=.volumes` is the one write grant in either tier, and it is narrow on
    // purpose: a test that needs a real folder (not a fake filesystem) gets one under
    // `.volumes/it/` through `createScratchFolder` (#73), never `Deno.makeTempDir()`, which
    // writes outside this grant and stays refused.
    "test:integration": "deno test --no-prompt --allow-read --allow-env --allow-net --allow-write=.volumes **/*.integration.test.ts",
    "services:up": "docker compose -f infra/compose.integration.yml up -d --wait",
    "services:down": "docker compose -f infra/compose.integration.yml down -v",
    "services:logs": "docker compose -f infra/compose.integration.yml logs",
    // Simulates a JSR publish of every workspace member and fails on a dangling `exports`
    // target (TS2307) — the failure mode that blocked the sibling `time/` package. A task
    // rather than a bare command so `deno task check:cold publish:dry` can wrap it (#111);
    // `check:cold` only accepts task names, not an arbitrary command line.
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": ["lint:fix", "fmt"]
    }
  },
  "imports": {
    // The integration tier's shared harness (#74): service addresses, the
    // fail-loudly reachability check and the unique-name helpers. A local path,
    // not a dependency. It sits in `infra/` — which is not a workspace member —
    // so a test-only helper can never be published as part of a package.
    "@integration-testing": "./infra/testing/+lib.ts",

    // Validation — arktype only, never zod. `platform/` types (#10, #23),
    // `ai/chatJson` schemas (#11), `server/auth` bodies (#6).
    "arktype": "npm:arktype@2.2.3",

    // Stdlib. Nothing else may be added without naming the issue that needs it.
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/expect": "jsr:@std/expect@1.0.20",
    // `@std/testing` has no "." export — only subpaths — so only the one
    // subpath in use is mapped; a bare `@std/testing` entry has no importer.
    "@std/testing/bdd": "jsr:@std/testing@1.0.20/bdd",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/crypto": "jsr:@std/crypto@1.1.0",
    // `platform/tokens.ts`'s ULID generator (#70): replaces a hand-written encoder that existed
    // only because this pin was missing.
    "@std/ulid": "jsr:@std/ulid@1.0.0",

    // HTTP framework. `server/http` (#9) and `platform/rate-limit` (#4)
    // middleware.
    "hono": "jsr:@hono/hono@4.13.8",

    // Postgres driver for `server/db` (#15).
    "postgres": "npm:postgres@3.4.7",

    // Authenticator-app codes (TOTP) and their enrolment QR code for the sign-in set (#75).
    // Both are on the house "keep" list; the template uses the same two packages.
    "otpauth": "jsr:@hectorm/otpauth@9.5.2",
    "qrcode": "jsr:@libs/qrcode@3.1.0"
  },
  "compilerOptions": {
    // An explicit "lib" replaces Deno's default lib set, so "deno.ns" has to be
    // listed back or `Deno.*` disappears from every repository script.
    "lib": ["ES2020", "DOM", "DOM.Iterable", "deno.ns"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [
    ".volumes",
    "**/coverage/*",
    "**/dist/*",
    "node_modules",
    "*.lock"
  ],
  // Every package inherits this from the workspace root (Deno 2.9.7, verified by dry run —
  // see PR #89's evidence block for the shipped file list per package). Three exports look
  // test-only but stay published on purpose: `realtime/testing.ts` and
  // `server/auth/testing/memory-adapter.ts` sit under a `testing` path, and
  // `server/storage/memory-fs.ts` has a test-ish name. All three are real exports, listed in
  // their package's `deno.json`.
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "email/fixtures",
      "server/__fixtures__",
      "platform/server/_fake-fs.ts",
      "server/auth/testing/harness.ts",
      "server/db/testing"
    ]
  }
}
